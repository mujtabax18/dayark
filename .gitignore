# Keep Flutter resolution metadata/source manifests and templates:
# pubspec.lock, .fvmrc, android/key.properties.example, gradle wrapper.

# Python helper caches
**/__pycache__/
*.pyc
*.pyo

# Release archives written outside the dist folder (also ignore them)
*.zip
*.tar.gz
*.7z
